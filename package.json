{
  "name": "dapcook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "test": "vitest run",
    "test:ci": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "backfill:covers": "node --env-file=.env.local scripts/backfill-recipe-covers.ts",
    "e2e:db:start": "supabase start --workdir e2e",
    "e2e:db:reset": "supabase db reset --workdir e2e",
    "e2e:db:stop": "supabase stop --workdir e2e"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mozilla/readability": "^0.6.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.99.2",
    "canvas-confetti": "^1.9.4",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "linkedom": "0.16.11",
    "lucide-react": "^1.77.0",
    "next": "^16.4.6",
    "next-intl": "^4.14.4",
    "nextjs-toploader": "^3.9.17",
    "posthog-js": "^1.376.0",
    "posthog-node": "^5.52.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "shadcn-ui": "^0.9.5",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^31.0.1",
    "postcss": "^8",
    "supabase": "^3.3.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "use-intl": "^4.14.4",
    "vitest": "^5.1.1"
  }
}
